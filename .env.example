# Copy to .env at the repository root. Never commit real values.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection used by Prisma (Phase 2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fogaan_dawo?schema=public

# --- Web (apps/web) — only VITE_* values are exposed to the browser ---
VITE_API_URL=/api
# Dev proxy target for /api requests (defaults to http://localhost:$PORT)
# API_PROXY_TARGET=http://localhost:4000
