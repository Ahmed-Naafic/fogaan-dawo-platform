# Copy to .env at the repository root. Never commit real values.

# --- API (apps/api) ---
# Do not set NODE_ENV here: Vite reads this file, and NODE_ENV=development makes `npm run build`
# bundle React's development build. The API defaults to development when NODE_ENV is unset.
PORT=5000
# Comma-separated browser origins allowed to call the API with credentials (never "*").
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (correct client IPs for rate limiting). 0 = none.
# TRUST_PROXY=0

# --- Authentication ---
# REQUIRED. Random, >= 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# JWT_ISSUER=fogaan-dawo-api
# JWT_AUDIENCE=fogaan-dawo-app
# Access-token lifetime in seconds (60–3600). Default 900 (15 min).
# ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-token/session lifetime in days (1–90). Default 30.
# REFRESH_TOKEN_TTL_DAYS=30
# bcrypt cost factor (10–15). Default 12.
# BCRYPT_ROUNDS=12
# Refresh cookie "Secure" flag. Defaults to true only when NODE_ENV=production.
# COOKIE_SECURE=false
# Login/register/refresh attempts per IP per window. Defaults: 20 per 15 minutes.
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Doctor-document uploads per IP per 15 minutes.
# UPLOAD_RATE_LIMIT_MAX=30
# Availability changes per IP per 15 minutes; public directory reads per IP per 5 minutes.
# AVAILABILITY_RATE_LIMIT_MAX=60
# PUBLIC_RATE_LIMIT_MAX=300

# --- Google sign-in (optional; API only — never use VITE_* names for these) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# The redirect URI must be registered there exactly. It is on the web origin; the dev proxy forwards it to the API.
# If any value is missing, Google sign-in is shown as unavailable.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5190/api/v1/auth/google/callback
# WEB_APP_URL=http://localhost:5190
# Random, >= 32 characters (encrypts the short-lived OAuth cookie). Generate like JWT_ACCESS_SECRET.
# OAUTH_STATE_SECRET=

# --- Web Push notifications (optional; API only) ---
# Generate once: npx web-push generate-vapid-keys. The public key is served to browsers by the API;
# the private key never leaves the server. Missing values = push unavailable (in-app still works).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com
# Background loops (seconds; 0 disables): notification delivery and appointment reminders.
# NOTIFICATION_DISPATCH_INTERVAL_SECONDS=3
# REMINDER_SWEEP_INTERVAL_SECONDS=60

# --- Private file storage ---
# STORAGE_DRIVER: "local" (disk; development/tests/long-running hosts) or "supabase" (Supabase Storage,
# required on Vercel). Neon stays the database; Supabase is object storage only.
STORAGE_DRIVER=local
# Local driver folder (never served statically). Default: <repo>/storage/private
# STORAGE_DIR=
# Supabase driver — BACKEND ONLY. Never put these in a VITE_* variable or any frontend file.
# Use a separate Supabase project for development (.env.development) and production (hosting secrets).
# Private buckets: fd-verification, fd-photos, fd-prescriptions, fd-medical, fd-staging
#   (create them in development with: npm run storage:setup-dev)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service role secret>

# --- Database: Neon PostgreSQL ---
# Neon console → your project → Branches → your branch → Connect.
# DATABASE_URL: the *pooled* connection string (host contains "-pooler"); used by the app at runtime.
# DIRECT_URL:   the *direct* connection string (no "-pooler"); used by migrations and tests.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Which database the URLs above point at: "development" or "production" (scripts/db-guard.mjs).
# On production, db:status / db:migrate:deploy and the database tests run only when the single command
# is prefixed with ALLOW_PRODUCTION_DB=true (never put that in this file); db:seed always refuses.
DATABASE_ENV=development

# --- Web (apps/web) — only VITE_* values are exposed to the browser ---
# API base URL used by the web client. "/api" goes through the Vite dev proxy (same origin, so the
# HTTP-only refresh cookie is first-party). Use an absolute URL only if the API is on another origin
# listed in CORS_ORIGIN.
VITE_API_URL=/api
# Optional: WebSocket base for video-call signalling when /api is a rewrite that cannot carry WebSockets,
# e.g. VITE_SIGNAL_URL=wss://api.example.com/api (the API host must allow the web origin in CORS_ORIGIN).
# VITE_SIGNAL_URL=
# Dev proxy target for /api (defaults to http://localhost:$PORT).
# API_PROXY_TARGET=http://localhost:5000

# Optional: password for the seeded *.test development accounts (min 12 chars).
# Leave unset to create the accounts with a random, unusable password.
# SEED_DEV_PASSWORD=
# Realistic demo data (extra doctors in several time zones, patients, past/upcoming consultations,
# payments, ratings). Set to false to seed only the base accounts.
# SEED_DEMO=true

# --- Video consultations (WebRTC, peer-to-peer, STUN only — no TURN in this phase) ---
# Comma-separated stun:/stuns: URLs. Unset → stun:stun.l.google.com:19302. Empty → no STUN (same-network calls only).
# STUN alone does NOT connect every network (carrier NAT, strict firewalls); TURN can be added later in apps/api/src/config/webrtc.js.
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# Per-IP limit for /api/v1/consultations requests per 5 minutes (default 200).
# CONSULTATION_RATE_LIMIT_MAX=200

# --- Background jobs and extra limits ---
# Secret for /api/internal/jobs/* (Vercel Cron or an external scheduler sends it as a Bearer token). 32+ random chars.
# CRON_SECRET=
# Long-running server only: how often unpaid holds are released (seconds; 0 disables).
# HOLD_SWEEP_INTERVAL_SECONDS=60
# Per-IP limits (requests per window).
# PROFILE_RATE_LIMIT_MAX=60
# MESSAGE_RATE_LIMIT_MAX=30
# PATIENT_RECORDS_RATE_LIMIT_MAX=300
